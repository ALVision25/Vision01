{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      ".firebaseignore",
      ".gitignore",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "index_comp.html",
      "fortdrum.html",
      "antwerpvillage.html",
      "mcallister.html"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|woff|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  }
}
